# Macan WCN7750 uses ICNSS/WPSS, not Lighthouse's CNSS PCIe fs_ready node.
# Modules are loaded from installed firmware by AERA, not shipped in ramdisk.
on property:post.decrypt.modules=true
    setprop sys.aera.wlan.up 0
    # AERA's post-decrypt module loader already exposes active-slot firmware.
    # Boot WCN7750 only after its installed modules have been loaded.
    write /sys/kernel/icnss/wlan_en_delay 1000
    write /sys/kernel/icnss/wpss_boot 1
    start aera-wlan-ready

on property:wifi.driver.ready=true
    mkdir /tmp/recovery 0777 root root
    mkdir /tmp/recovery/sockets 0777 root root
    start wpa_supplicant

on property:sys.aera.wlan.up=1 && property:wifi.driver.ready=true
    setprop sys.aera.wlan.up 0
    start wpa_supplicant

service wpa_supplicant /system/bin/wpa_supplicant -Dnl80211 -iwlan0 -dd -O/tmp/recovery/sockets -c/vendor/etc/wifi/wpa_supplicant.conf
    disabled
    seclabel u:r:recovery:s0

service aera-wlan-ready /system/bin/sh /system/bin/aera-wlan-ready.sh
    user root
    group root
    disabled
    oneshot
    seclabel u:r:recovery:s0
