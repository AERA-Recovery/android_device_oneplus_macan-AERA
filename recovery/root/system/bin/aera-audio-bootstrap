#!/system/bin/sh
# Copyright (C) 2026 AERA Recovery Project contributors
# SPDX-License-Identifier: Apache-2.0
#
# Mount the installed macan stock audio stack read-only and start the
# services used by AERA's protected PAL playback path.

PATH=/system/bin:/sbin
export PATH
stock_root=/mnt/aera-stock
vendor_root=${stock_root}/vendor
system_root=${stock_root}/system
odm_root=${stock_root}/odm
vendor_dlkm_root=${stock_root}/vendor_dlkm
audio_abi=/vendor/aera-audio-abi
lock=${stock_root}/.audio-lock
slot_suffix="$(getprop ro.boot.slot_suffix)"

report() {
    echo "AERA audio: $*" > /dev/kmsg
}

fail() {
    report "FAILED: $*"
    echo "AERA audio: $*" >&2
    exit 1
}

report "bootstrap starting after decryption"

case "$(getprop ro.product.device)" in
    macan|PLR110|CPH2767|CPH2769|CPH2771|OP6117L1|OP612DL1) ;;
    *)
        case "$(getprop ro.product.vendor.device)" in
            macan|PLR110|CPH2767|CPH2769|CPH2771|OP6117L1|OP612DL1) ;;
            *) fail "this backend is only valid on macan/OnePlus 15R" ;;
        esac
        ;;
esac

mkdir -p "${stock_root}" "${vendor_root}" "${system_root}" "${odm_root}" \
    "${vendor_dlkm_root}" /odm/firmware /odm/firmware/fastchg \
    /odm/lib/rfsa/adsp /firmware \
    /vendor/firmware_mnt /vendor/dsp /vendor/lib/rfsa/adsp \
    /vendor/etc/acdbdata \
    /vendor/etc/audio /vendor/aera-stock-lib64 \
    "${audio_abi}" /vendor/etc/seccomp_policy /data/vendor/battery
chmod 0755 "${stock_root}" /odm/firmware /vendor/lib /vendor/lib/rfsa
chown 1000:1000 /data/vendor/battery
lock_attempt=0
while ! mkdir "${lock}" 2>/dev/null; do
    [ "$(getprop init.svc.aera-agm-service)" = running ] && exit 0
    lock_attempt=$((lock_attempt + 1))
    [ "${lock_attempt}" -ge 300 ] && fail "another bootstrap did not finish"
    sleep 0.1
done
trap 'rmdir "${lock}" 2>/dev/null' EXIT

find_partition() {
    part="$1"
    for candidate in \
        "/dev/block/mapper/${part}${slot_suffix}" \
        "/dev/block/mapper/${part}"; do
        [ -b "${candidate}" ] && { echo "${candidate}"; return 0; }
    done
    return 1
}

is_mounted() {
    awk -v target="$1" '$5 == target { found = 1 } END { exit !found }' \
        /proc/self/mountinfo
}

private_mount() {
    # Toybox looks up a single-argument mount in fstab even for propagation
    # changes. The kernel ignores this explicit source for MS_PRIVATE.
    mount -o private none "$1" || fail "could not isolate audio mount $1"
}

mount_read_only() {
    part="$1"
    target="$2"
    if is_mounted "${target}"; then
        private_mount "${target}"
        return 0
    fi
    source=""
    find_attempt=0
    while [ -z "${source}" ] && [ "${find_attempt}" -lt 100 ]; do
        source="$(find_partition "${part}")"
        [ -n "${source}" ] && break
        find_attempt=$((find_attempt + 1))
        sleep 0.1
    done
    [ -n "${source}" ] || return 1
    mount -t erofs -o ro "${source}" "${target}" 2>/dev/null || \
        mount -t ext4 -o ro,noload "${source}" "${target}" 2>/dev/null || return 1
    # Bind clones inherit the source's propagation group. Private sources
    # prevent later file overlays from propagating back into stock mounts or
    # into other aliases, which would create stacks on every audio retry.
    private_mount "${target}"
}

mount_read_only vendor "${vendor_root}" || fail "could not mount stock vendor"
mount_read_only system "${system_root}" || fail "could not mount stock system"
mount_read_only odm "${odm_root}" || fail "could not mount stock odm"
mount_read_only vendor_dlkm "${vendor_dlkm_root}" || \
    fail "could not mount stock vendor_dlkm"
report "slot-matched stock audio partitions mounted read-only"

# Oplus has changed the charger HAL filename between firmware generations.
# Resolve the service from the installed ODM rather than hard-coding V11.
charger_service=""
for candidate in \
    "${odm_root}/bin/hw/vendor.oplus.hardware.charger-V11-service" \
    "${odm_root}/bin/hw/vendor.oplus.hardware.charger-V12-service" \
    "${odm_root}/bin/hw/vendor.oplus.hardware.charger-V10-service" \
    "${odm_root}/bin/hw/vendor.oplus.hardware.charger-service" \
    ${odm_root}/bin/hw/vendor.oplus.hardware.charger*-service \
    ${vendor_root}/bin/hw/vendor.oplus.hardware.charger*-service; do
    if [ -x "${candidate}" ]; then
        charger_service="${candidate}"
        break
    fi
done
[ -n "${charger_service}" ] || \
    fail "could not find the installed Oplus charger HAL"
rm -f "${stock_root}/oplus-charger-service"
ln -s "${charger_service}" "${stock_root}/oplus-charger-service" || \
    fail "could not expose the installed Oplus charger HAL"
report "using charger HAL ${charger_service}"

# The dedicated slot-matched DSP partition carries AudioPD modules. Android
# mounts it before audioadsprpcd starts and exposes the legacy /dsp alias.
# Keep this after FBE/decryption, alongside the rest of the stock audio mounts.
if ! is_mounted "/vendor/dsp"; then
    dsp="/dev/block/bootdevice/by-name/dsp${slot_suffix}"
    [ -b "${dsp}" ] || dsp="/dev/block/by-name/dsp${slot_suffix}"
    [ -b "${dsp}" ] || fail "the active DSP partition is missing"
    mount -t ext4 -o ro,noload "${dsp}" /vendor/dsp || \
        fail "could not mount the DSP module partition"
fi
private_mount /vendor/dsp
[ -e /dsp ] || ln -s /vendor/dsp /dsp || \
    fail "could not expose the stock /dsp path"

# Qualcomm's audio processes are built against the framework Binder ABI from
# the installed macan system. Recovery's Binder-NDK library is close enough to
# load but is not compatible with the vendor-side Binder snapshot, causing
# audioadsprpcd and dspservice to restart before AudioPD comes up. Expose only
# the two ABI-matched Binder libraries rather than overlaying /system. Their
# matching C++ runtime is shipped from the stock ART APEX in this device tree;
# the ordinary /system libc++ stub lacks std::__1::__hash_memory.
system_lib64="${system_root}/system/lib64"
[ -f "${system_lib64}/libbinder.so" ] || system_lib64="${system_root}/lib64"
bind_file_read_only() {
    source_file="$1"
    target_file="$2"
    [ -f "${source_file}" ] || fail "missing stock file ${source_file}"
    [ -e "${target_file}" ] || touch "${target_file}" || \
        fail "could not create bind target ${target_file}"
    if ! is_mounted "${target_file}"; then
        mount -o bind "${source_file}" "${target_file}" || \
            fail "could not bind ${source_file}"
        mount -o remount,bind,ro "${target_file}" 2>/dev/null
    fi
    private_mount "${target_file}"
}
bind_file_read_only "${system_lib64}/libbinder.so" \
    "${audio_abi}/libbinder.so"
bind_file_read_only "${system_lib64}/libbinder_ndk.so" \
    "${audio_abi}/libbinder_ndk.so"
[ -f "${audio_abi}/libc++.so" ] || \
    fail "missing stock ART C++ runtime for Binder ABI"
# The TFA speaker codec requests its device-matched tuning container from ODM.
bind_file_read_only "${odm_root}/firmware/tfa98xx.cnt" \
    "/odm/firmware/tfa98xx.cnt"
if [ -d "${odm_root}/firmware/fastchg" ] && \
   ! is_mounted "/odm/firmware/fastchg"; then
    mount -o bind "${odm_root}/firmware/fastchg" /odm/firmware/fastchg || \
        fail "could not expose the stock charger configuration"
    mount -o remount,bind,ro /odm/firmware/fastchg 2>/dev/null
fi
# The policy shipped alongside aera-dspservice must remain visible to init's
# service namespace, without depending on the stock mounts created here.
[ -r /vendor/etc/seccomp_policy/vendor.qti.hardware.dsp.policy ] || \
    fail "missing ramdisk DSP seccomp policy"

# Keep AERA's vendor tree and GPU userspace visible. Qualcomm's matching
# library directory is exposed under /vendor so the vendor linker namespace
# accepts it, without overlaying /vendor or disturbing a running/restarted UI.
if ! is_mounted "/vendor/aera-stock-lib64"; then
    mount -o bind "${vendor_root}/lib64" /vendor/aera-stock-lib64 || \
        fail "could not expose the installed stock audio libraries"
    mount -o remount,bind,ro /vendor/aera-stock-lib64 2>/dev/null
fi

# The modem partition owns the ADSP images and service-locator JSON files.
# Recovery normally unmounts it after the PMIC bootstrap, so restore it for
# the long-lived audio DSP and expose the path expected by Qualcomm userspace.
if ! is_mounted "/firmware"; then
    modem="/dev/block/bootdevice/by-name/modem${slot_suffix}"
    [ -b "${modem}" ] || modem="/dev/block/by-name/modem${slot_suffix}"
    [ -b "${modem}" ] || fail "the active modem firmware partition is missing"
    mount -t vfat -o ro "${modem}" /firmware || \
        fail "could not mount the ADSP firmware partition"
fi
if ! is_mounted "/vendor/firmware_mnt"; then
    private_mount /firmware
    mount -o bind /firmware /vendor/firmware_mnt || \
        fail "could not expose ADSP firmware to stock vendor"
fi

# AGM prefers the device-specific ODM calibration database. Recovery already
# owns /odm as a rootfs directory, so expose only the required stock subtree.
[ -d "${odm_root}/etc/acdbdata" ] || \
    fail "missing stock ODM audio calibration database"
mkdir -p /odm/etc/acdbdata
if ! is_mounted "/odm/etc/acdbdata"; then
    mount -o bind "${odm_root}/etc/acdbdata" /odm/etc/acdbdata || \
        fail "could not expose the stock ODM audio calibration database"
    mount -o remount,bind,ro /odm/etc/acdbdata 2>/dev/null
fi

# Keep the vendor calibration files available for codecs which use them.
if [ -d "${vendor_root}/etc/acdbdata" ] && \
   ! is_mounted "/vendor/etc/acdbdata"; then
    mount -o bind "${vendor_root}/etc/acdbdata" /vendor/etc/acdbdata || \
        fail "could not expose the stock calibration database"
fi
if [ -d "${vendor_root}/etc/audio" ] && \
   ! is_mounted "/vendor/etc/audio"; then
    mount -o bind "${vendor_root}/etc/audio" /vendor/etc/audio || \
        fail "could not expose the stock audio service configuration"
fi

# PAL derives these names from the actual alor-mtp-wcd9378 sound card.
# Expose the installed ODM tuning under both the codec-specific name and
# PAL's variant-less fallback. Canoe aliases alone leave the ramdisk runtime
# without speaker routes once the temporary stock /vendor overlay is gone.
for config in mixer_paths resourcemanager; do
    for card_variant in alor_mtp_wcd9378 alor_mtp; do
        bind_file_read_only "${odm_root}/etc/${config}.xml" \
            "/vendor/etc/${config}_${card_variant}.xml"
    done
done
bind_file_read_only "${odm_root}/etc/usecaseKvManager.xml" \
    "/vendor/etc/usecaseKvManager.xml"
bind_file_read_only "${vendor_root}/etc/audio/sku_alor/plugin_manager.xml" \
    "/vendor/etc/plugin_manager.xml"
report "Macan Alor speaker mixer and resource-manager configurations exposed"

# Oplus speaker processing is loaded into AudioPD on demand. These device-only
# DSP modules live in ODM, while adsprpc searches the legacy vendor RFSA path.
if ! is_mounted "/vendor/lib/rfsa/adsp"; then
    mount -o bind "${odm_root}/lib/rfsa/adsp" /vendor/lib/rfsa/adsp || \
        fail "could not expose the stock ODM AudioPD modules"
    mount -o remount,bind,ro /vendor/lib/rfsa/adsp 2>/dev/null
fi
if ! is_mounted "/odm/lib/rfsa/adsp"; then
    mount -o bind "${odm_root}/lib/rfsa/adsp" /odm/lib/rfsa/adsp || \
        fail "could not expose the stock ODM AudioPD path"
    mount -o remount,bind,ro /odm/lib/rfsa/adsp 2>/dev/null
fi
for config in card-defs.xml mem_logger_config.xml; do
    source_config="${vendor_root}/etc/${config}"
    target_config="/vendor/etc/${config}"
    [ -f "${source_config}" ] && [ -f "${target_config}" ] && \
        bind_file_read_only "${source_config}" "${target_config}"
done

# Keep directory aliases private too, including mounts reused by bootstrap
# after a live fastbootd session. File binds use the same check above so a
# retry never stacks another bind over an already mounted destination.
for target in /firmware /vendor/firmware_mnt /vendor/dsp /vendor/aera-stock-lib64 \
    /odm/firmware/fastchg /odm/etc/acdbdata /vendor/etc/acdbdata \
    /vendor/etc/audio /vendor/lib/rfsa/adsp /odm/lib/rfsa/adsp; do
    is_mounted "${target}" && private_mount "${target}"
done
report "stock audio mounts isolated for dynamic-partition teardown"

mkdir -p /data/vendor/audio/acdbdata/delta /data/vendor/audio_dsp

start_init_service() {
    service="$1"
    required="$2"
    state="$(getprop "init.svc.${service}")"
    report "starting ${service}; previous state=${state}"
    [ "${state}" = running ] && return 0
    setprop ctl.start "${service}"
    attempt=0
    while [ "$(getprop "init.svc.${service}")" != running ] && \
          [ "${attempt}" -lt 50 ]; do
        attempt=$((attempt + 1))
        sleep 0.1
    done
    [ "$(getprop "init.svc.${service}")" = running ] && return 0
    [ "${required}" = required ] && fail "init service ${service} did not start"
    echo "AERA audio: optional service ${service} is unavailable" >&2
    return 0
}

dump_audio_state() {
    # Include the missing probe/component in normal debug bundles, without
    # needing a separate tester session to mount debugfs and collect it.
    if ! grep -q ' /sys/kernel/debug debugfs ' /proc/mounts; then
        mkdir -p /sys/kernel/debug
        mount -t debugfs debugfs /sys/kernel/debug 2>/dev/null
    fi
    audio_state=/tmp/aera-audio-state.txt
    {
        echo "=== ALSA cards and nodes ==="
        cat /proc/asound/cards
        ls -l /dev/snd
        echo "=== BT audio endpoint modules ==="
        grep -E '^(btpower|btfmcodec|bt_fm_swr|lpass_bt_swr_dlkm|machine_dlkm) ' /proc/modules
        echo "=== Deferred probes ==="
        cat /sys/kernel/debug/devices_deferred
        echo "=== ASoC components ==="
        cat /sys/kernel/debug/asoc/components
        echo "=== ASoC DAIs ==="
        cat /sys/kernel/debug/asoc/dais
        echo "=== Speaker driver bindings ==="
        ls -l /sys/bus/i2c/devices/20-0034/driver /sys/bus/i2c/devices/20-0035/driver
        echo "=== Remote processors ==="
        for processor in /sys/class/remoteproc/remoteproc*; do
            [ -r "${processor}/name" ] || continue
            cat "${processor}/name" "${processor}/state"
        done
    } > "${audio_state}" 2>&1
    while IFS= read -r audio_line; do
        report "state: ${audio_line}"
    done < "${audio_state}"
}

start_adsp() {
    adsp_remoteproc=""
    for candidate in /sys/class/remoteproc/remoteproc*; do
        [ -r "${candidate}/name" ] || continue
        case "$(cat "${candidate}/name")" in
            *remoteproc-adsp)
                adsp_remoteproc="${candidate}"
                break
                ;;
        esac
    done
    [ -n "${adsp_remoteproc}" ] || fail "could not find the ADSP remoteproc"

    if [ "$(cat "${adsp_remoteproc}/state" 2>/dev/null)" != running ]; then
        echo start > "${adsp_remoteproc}/state" || fail "could not boot the ADSP"
    fi

    attempt=0
    while [ "$(cat "${adsp_remoteproc}/state" 2>/dev/null)" != running ] && \
          [ "${attempt}" -lt 100 ]; do
        attempt=$((attempt + 1))
        sleep 0.1
    done
    [ "$(cat "${adsp_remoteproc}/state" 2>/dev/null)" = running ] || \
        fail "the ADSP did not enter the running state"
}

# These must precede the SPF/machine probe. In particular audioadsprpcd
# creates Qualcomm's audiopd and its APM endpoint. Running it through init
# also gives it the stock SELinux domain instead of recovery/su.
start_init_service aera-oplus-charger required
start_init_service aera-pd-mapper required
start_init_service aera-dspservice required
start_init_service aera-audioadsprpcd required
start_adsp

# Stock starts audioadsprpcd during early-init, before the Canoe machine
# driver is inserted. Loading machine_dlkm with the rest of recovery's early
# module set makes its one-shot probe run before AudioPD exists; the codec
# components bind later, but no ALSA card is ever published. Keep every
# dependency in the normal module set and insert only the machine driver here,
# after AudioPD has had time to create its APM endpoint.
if ! grep -q '^machine_dlkm ' /proc/modules; then
    machine_module="${vendor_dlkm_root}/lib/modules/machine_dlkm.ko"
    [ -f "${machine_module}" ] || \
        fail "the installed machine audio driver is missing"
    sleep 1
    /system/bin/insmod "${machine_module}" || \
        fail "could not load the Qualcomm machine audio driver"
    report "Qualcomm machine audio driver loaded after AudioPD startup"
else
    report "Qualcomm machine audio driver was already loaded"
fi

report "DSP services ready; waiting up to 20s for /dev/snd/controlC0"

attempt=0
# card 100 is tinyalsa's virtual AGM plugin id; the kernel machine card itself
# is allocated a normal ALSA index (normally controlC0).
while [ ! -e /dev/snd/controlC0 ] && [ "${attempt}" -lt 200 ]; do
    attempt=$((attempt + 1))
    sleep 0.1
done
if [ ! -e /dev/snd/controlC0 ]; then
    dump_audio_state
    fail "the Qualcomm machine sound card did not register"
fi
report "sound card registered after ${attempt} polling intervals"

# The init service owns the stock-library environment. Do not export it here:
# recovery's toolbox/getprop/setprop require AERA's matching system libraries.
start_init_service aera-agm-service required

report "Macan AGM backend process started; aera-audio-service reports Binder readiness"
